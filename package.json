{
  "name": "parallax",
  "version": "2.1.0",
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "evaluate": "node scripts/evaluate.mjs",
    "ios:build": "npm run build && node scripts/build-ios.mjs",
    "ios:sync": "npm run ios:build && cap sync ios",
    "ios:open": "cap open ios",
    "ios:package": "node scripts/package-ios.mjs"
  },
  "dependencies": {
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.6.2",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.6.2",
    "@capacitor/network": "8.0.1",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.3",
    "esbuild": "^0.25.0",
    "satellite.js": "^6.0.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2"
  }
}
